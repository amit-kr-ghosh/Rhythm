# Copy to .env and fill in. Only PUBLIC (anon/publishable) values belong here.
# NEVER put the Supabase service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Set to "true" only after configuring the Google provider in Supabase (see README)
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
