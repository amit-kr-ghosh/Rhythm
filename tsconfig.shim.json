{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "preserve",
    "strict": true, "noImplicitAny": false, "noUncheckedIndexedAccess": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "types": ["node"], "lib": ["ES2022", "DOM"]
  },
  "include": ["tools/typecheck/shims.d.ts", "src/**/*.ts", "src/**/*.tsx", "app/**/*.ts", "app/**/*.tsx"],
  "exclude": ["tests"]
}
